{
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "target": "esnext",
    // Avoid warning for conflicting generated JS files,
    // emitting is needed only in build config
    "noEmit": true
  },
  "include": ["src"]
}
